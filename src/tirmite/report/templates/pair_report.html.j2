{% extends "_base.html.j2" %}

{% block content %}

<div class="tiles">
  {% for tile in summary %}
  <div class="tile">
    <div class="label">{{ tile.label }}</div>
    <div class="value">{{ tile.value }}</div>
    <div class="detail">{{ tile.detail }}</div>
  </div>
  {% endfor %}
</div>

<section id="tracks-section">
  <h2>Annotation tracks</h2>
  <p class="note">
    Swipe or drag sideways to pan, scroll vertically to zoom, double-click an
    annotation to frame it. Arrow keys pan and <kbd>+</kbd>/<kbd>-</kbd> zoom
    when a track has focus. Hover an annotation for a summary; <strong>click it
    to open the full details and its element sequence</strong>.
  </p>

  {# The legend is always present: colour alone never carries identity. #}
  <div class="legend">
    {% for group in data.groups %}
    <span class="legend-item">
      <span class="swatch" style="background: var(--group-{{ loop.index0 }})"></span>
      {{ group.label }}
    </span>
    {% endfor %}
    <span class="legend-item"><span class="swatch unpaired"></span>unpaired terminus</span>
    <span class="legend-item"><span class="swatch clipped"></span>truncated by contig end</span>
    <span class="legend-item muted">jagged edge = model not fully matched</span>
  </div>

  <div class="controls">
    <label>
      Find sequence
      <input type="search" id="contig-search" placeholder="e.g. chr1" autocomplete="off">
    </label>
    <label>
      <input type="checkbox" id="show-empty">
      Show sequences without pairs
    </label>
    <span class="muted" id="track-count"></span>
  </div>

  <div id="tracks"></div>
</section>

{% if data.figures %}
<section id="figures-section">
  <h2>Distributions</h2>
  <div class="figures">
    {% for figure in data.figures %}
    <figure id="figure-{{ figure.id }}">
      <h3>{{ figure.title }}</h3>
      {{ figure.svg | safe }}
      <figcaption>{{ figure.caption }}</figcaption>
    </figure>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if data.msa %}
<section id="alignments-section">
  <h2>Terminus alignments</h2>
  <p class="note">
    Every hit for each terminus model, aligned. Grey marks model positions the
    hit did not match although the genome continues; blank marks sequence that
    does not exist because the contig ended. Hover a row for its hit, click to
    show it on its contig.
  </p>
  <div class="legend">
    <span class="legend-item"><span class="swatch" style="background: var(--base-a)"></span>A</span>
    <span class="legend-item"><span class="swatch" style="background: var(--base-c)"></span>C</span>
    <span class="legend-item"><span class="swatch" style="background: var(--base-g)"></span>G</span>
    <span class="legend-item"><span class="swatch" style="background: var(--base-t)"></span>T</span>
    <span class="legend-item"><span class="swatch" style="background: var(--base-other)"></span>other base</span>
    <span class="legend-item"><span class="swatch clipped"></span>model not matched</span>
  </div>
  <div id="msa-panels"></div>
</section>
{% endif %}

<section id="hits-section">
  <h2>Hits and elements</h2>
  <p class="note">
    Every terminus hit and every predicted element, filterable and sortable.
    Large tables show their first rows only; the filter searches all of them,
    and the download button writes the complete table as TSV.
  </p>

  <h3>All terminus hits</h3>
  <div id="all-hits-table"></div>

  {% if data.elements %}
  <h3>Predicted elements</h3>
  <div id="elements-table"></div>
  {% endif %}
</section>

<section id="stats-section">
  <h2>Statistics</h2>
  <p class="note">
    Every value shown on the tracks is also listed here, so nothing depends on
    hovering. Click a column heading to sort.
  </p>

  <h3>Pairing groups</h3>
  {% set table_id = 'groups' %}
  {% set caption = 'Outcome of each pairing procedure.' %}
  {% set columns = [
    {'key': 'group', 'label': 'Pairing', 'num': false},
    {'key': 'orientation', 'label': 'Orientation', 'num': false},
    {'key': 'pairs', 'label': 'Pairs', 'num': true},
    {'key': 'elements', 'label': 'Elements', 'num': true},
    {'key': 'unpaired', 'label': 'Unpaired hits', 'num': true},
    {'key': 'median_length', 'label': 'Median element', 'num': true},
  ] %}
  {% set rows = stats_groups %}
  {% include "_stats_table.html.j2" %}

  <h3>Terminus models</h3>
  {% set table_id = 'models' %}
  {% set caption = 'Hits per terminus model and how completely they match it.' %}
  {% set columns = [
    {'key': 'model', 'label': 'Model', 'num': false},
    {'key': 'length', 'label': 'Model length', 'num': true},
    {'key': 'hits', 'label': 'Hits', 'num': true},
    {'key': 'contigs', 'label': 'Sequences', 'num': true},
    {'key': 'paired', 'label': 'Paired', 'num': true},
    {'key': 'coverage', 'label': 'Median coverage', 'num': true},
    {'key': 'full', 'label': 'Full length', 'num': true},
    {'key': 'clipped', 'label': 'Contig-clipped', 'num': true},
  ] %}
  {% set rows = stats_models %}
  {% include "_stats_table.html.j2" %}

  <h3>Sequences</h3>
  {% set table_id = 'contigs' %}
  {% set caption = 'Every sequence carrying at least one terminus hit.' %}
  {% set columns = [
    {'key': 'contig', 'label': 'Sequence', 'num': false},
    {'key': 'length', 'label': 'Length', 'num': true},
    {'key': 'hits', 'label': 'Hits', 'num': true},
    {'key': 'pairs', 'label': 'Pairs', 'num': true},
    {'key': 'element_bp', 'label': 'Element bp', 'num': true},
    {'key': 'density', 'label': 'Elements / Mb', 'num': true},
  ] %}
  {% set rows = stats_contigs %}
  {% include "_stats_table.html.j2" %}

  {% if stats_filters %}
  <h3>Filtering</h3>
  {% set table_id = 'filters' %}
  {% set caption = 'Hit filters applied before pairing.' %}
  {% set columns = [
    {'key': 'filter', 'label': 'Filter', 'num': false},
    {'key': 'setting', 'label': 'Setting', 'num': false},
    {'key': 'excluded', 'label': 'Hits', 'num': true},
  ] %}
  {% set rows = stats_filters %}
  {% include "_stats_table.html.j2" %}
  {% endif %}
</section>

{% endblock %}
